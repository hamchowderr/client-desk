# The desk's database: Doltgres (version-controlled Postgres), so every change is
# a commit you can diff or roll back. Plain Postgres also works, without history.
# On Coolify, docker-compose.yaml sets this to the bundled Doltgres service.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/postgres

# Mastra's own tables (traces, threads, agent memory) in plain Postgres, e.g. the
# Supabase session pooler (port 5432). Keep the real value in Infisical.
MASTRA_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Bootstrap admin key (24+ chars). Lets you mint real keys with `npm run key:create`;
# can be removed once you have an admin key from the database.
DESK_ADMIN_KEY=

# Retainer spots shown on the board (Retainer page: 8).
DESK_CAPACITY=8

PORT=4111
MASTRA_TELEMETRY_DISABLED=1
